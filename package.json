{
  "name": "form-builder",
  "private": true,
  "version": "0.0.1",
  "description": "Hosted form builder: forms, connectors, work items with SLAs and approvals.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @fb/api dev",
    "dev:worker": "pnpm --filter @fb/api dev:worker",
    "dev:studio": "pnpm --filter @fb/studio dev",
    "dev:runtime": "pnpm --filter @fb/runtime dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:gateway": "pnpm --filter @fb/gateway build && node apps/gateway/dist/main.js",
    "lint": "eslint .",
    "e2e": "pnpm --filter @fb/e2e e2e"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0"
    }
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "typescript-eslint": "^8"
  }
}
