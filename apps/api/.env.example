NODE_ENV=development
PORT=4100
MONGODB_URL=mongodb://127.0.0.1:27017/form-builder
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32
SECRET_KEY=
# Studio (email links, SSO return) and this API's own public URL
APP_URL=http://localhost:5173
API_URL=http://localhost:4100
# Public form runtime (links in emails, save-and-resume)
FORM_APP_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false

# Mail: console (development) or ses (production)
MAIL_PROVIDER=console
MAIL_FROM=
AWS_REGION=ap-south-1

# Files: local (development) or s3 (production, IAM role - no keys)
STORAGE_PROVIDER=local
UPLOADS_BUCKET=
LOCAL_STORAGE_DIR=.local-uploads

# Connector credentials: KMS key (required in production); SECRET_KEY is used locally
KMS_KEY_ID=

# Plan for orgs billing hasn't set: FREE | TEAM | BUSINESS | ENTERPRISE
DEFAULT_PLAN=FREE

# Development only
FORM_ALLOW_MOCK_CAPTCHA=true
# CONNECTOR_ALLOW_PRIVATE_NETWORK=true   # connectors to localhost databases
# SSO_ALLOW_INSECURE_ISSUER=true         # an http:// test identity provider
# FORM_WEBHOOK_ALLOWLIST=hooks.example.com

# Background jobs: all (store and run here) | enqueue (API beside a worker). The worker sets run itself.
JOBS_ROLE=all

# Malware check on uploads: none | clamav (a clamd daemon; a file it cannot check is refused)
FILE_SCANNER=none
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Organisation guard: every database query must name the organisation (or be marked as working across them).
# report (the default) logs a query that does not, once per place; refuse makes it an error (tests run this way); off.
# ORG_SCOPE_MODE=report
# ORG_SCOPE_REPORT=/tmp/unscoped.tsv     # also write each such place to a file
