{
  "id": "complaint-form-basic-001",
  "orgId": "ORG001",
  "businessId": "BUSINESS001",
  "name": "Customer Complaint (Basic)",
  "code": "CUSTOMER_COMPLAINT_BASIC",
  "description": "Tell us what went wrong and we will get back to you.",
  "version": 1,
  "status": "PUBLISHED",
  "access": "PUBLIC",
  "fields": [
    { "id": "b1", "type": "HIDDEN", "name": "businessId", "systemSource": "BUSINESS_ID" },
    { "id": "b2", "type": "HIDDEN", "name": "submittedAt", "systemSource": "CURRENT_DATE" },
    {
      "id": "b3",
      "type": "TEXT",
      "name": "name",
      "label": "Name",
      "placeholder": "Your full name",
      "required": true,
      "validation": { "minLength": 2, "maxLength": 100 }
    },
    { "id": "b4", "type": "EMAIL", "name": "email", "label": "Email", "required": true },
    {
      "id": "b5",
      "type": "DROPDOWN",
      "name": "category",
      "label": "Complaint Category",
      "required": true,
      "dataSource": {
        "type": "STATIC",
        "options": [
          { "label": "Product", "value": "PRODUCT" },
          { "label": "Delivery", "value": "DELIVERY" },
          { "label": "Billing", "value": "BILLING" }
        ]
      }
    },
    {
      "id": "b6",
      "type": "TEXT",
      "name": "productName",
      "label": "Product Name",
      "required": true,
      "visibility": { "when": { "field": "category", "operator": "equals", "value": "PRODUCT" } }
    },
    {
      "id": "b7",
      "type": "TEXT",
      "name": "serialNumber",
      "label": "Serial Number",
      "helpText": "Printed on the label on the back of the product.",
      "visibility": { "when": { "field": "category", "operator": "equals", "value": "PRODUCT" } }
    },
    {
      "id": "b8",
      "type": "DATE",
      "name": "incidentDate",
      "label": "When did it happen?"
    },
    {
      "id": "b9",
      "type": "RADIO",
      "name": "severity",
      "label": "Severity",
      "required": true,
      "defaultValue": "MEDIUM",
      "dataSource": {
        "type": "STATIC",
        "options": [
          { "label": "Low", "value": "LOW" },
          { "label": "Medium", "value": "MEDIUM" },
          { "label": "High", "value": "HIGH" }
        ]
      }
    },
    {
      "id": "b10",
      "type": "NUMBER",
      "name": "amountDisputed",
      "label": "Amount disputed (INR)",
      "visibility": { "when": { "field": "category", "operator": "equals", "value": "BILLING" } },
      "validation": { "min": 1, "max": 10000000 }
    },
    {
      "id": "b11",
      "type": "TEXTAREA",
      "name": "description",
      "label": "Complaint Description",
      "placeholder": "Describe the issue in detail",
      "required": true,
      "validation": { "minLength": 30, "maxLength": 5000 },
      "props": { "rows": 5 }
    },
    {
      "id": "b12",
      "type": "CHECKBOX",
      "name": "contactMe",
      "label": "Please call me about this complaint"
    },
    {
      "id": "b13",
      "type": "PHONE",
      "name": "phone",
      "label": "Phone",
      "requiredWhen": { "field": "contactMe", "operator": "equals", "value": true }
    }
  ],
  "actions": {
    "submit": { "enabled": true, "label": "Submit Complaint" },
    "cancel": { "enabled": true, "label": "Clear", "behavior": "RESET" }
  },
  "submission": {
    "method": "POST",
    "endpointId": "complaint-submit",
    "success": { "type": "MESSAGE", "message": "Thank you. Your complaint has been registered." }
  },
  "createdBy": "system",
  "updatedBy": "system"
}
